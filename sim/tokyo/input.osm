  <tag k="description" v="Hanzomon Subway to Denentoshi Line thought service. In all hours the trains have mutual operations to Chuo-Rinkan station."/>
  <tag k="duration" v="60"/>
  <tag k="from" v="長津田"/>
  <tag k="interval" v="5"/>
  <tag k="interval:conditional" v="4 @(Sa-Su)"/>
  <tag k="name" v="東京メトロ半蔵門線 - 東急田園都市線直通運転"/>
